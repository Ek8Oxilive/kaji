# Clé secrète du dashboard (chiffrement des tokens Proxmox + sessions)
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
KAJI_SECRET_KEY=changeme

# Cookie de session en "Secure" (HTTPS ou localhost). Mettre false seulement en HTTP sur le réseau local.
KAJI_COOKIE_SECURE=true

# Machines que Kaji refuse de supprimer, quoi qu'il arrive (identifiants séparés par des virgules)
KAJI_PROTECTED_VMIDS=

# Derrière un reverse proxy de confiance uniquement : utilise l'IP que le proxy ajoute dans X-Forwarded-For
# pour le limiteur de connexions (sinon l'en-tête est falsifiable et ignoré).
KAJI_TRUST_PROXY=false

# Durée de conservation du journal d'audit, en jours (0 = indéfiniment)
KAJI_AUDIT_RETENTION_DAYS=365

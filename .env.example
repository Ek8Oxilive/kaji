# Clé secrète du dashboard (chiffrement des tokens Proxmox + sessions)
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
KAJI_SECRET_KEY=changeme

# Jeton de première configuration (facultatif mais recommandé) : tant qu'aucun compte n'existe, il est exigé pour créer le compte admin
# (sinon le premier qui atteint le port le crée). Générer : python3 -c "import secrets; print(secrets.token_urlsafe(24))"
KAJI_SETUP_TOKEN=

# Cookie de session en "Secure" (HTTPS ou localhost). Mettre false seulement en HTTP sur le réseau local.
KAJI_COOKIE_SECURE=true

# Machines que Kaji refuse de supprimer, quoi qu'il arrive (identifiants séparés par des virgules)
KAJI_PROTECTED_VMIDS=

# Session administrateur d'un clic avec le token permanent de Kaji (à n'activer que si ce token a reçu les droits d'administration dans Proxmox)
# KAJI_ADMIN_USE_KAJI_TOKEN=true

# Planificateur d'actions et alertes (une seule instance de Kaji doit tourner) : false les coupe
# KAJI_SCHEDULER=true

# Derrière un reverse proxy de confiance uniquement : utilise l'IP que le proxy ajoute dans X-Forwarded-For
# pour le limiteur de connexions (sinon l'en-tête est falsifiable et ignoré).
KAJI_TRUST_PROXY=false

# Durée de conservation du journal d'audit, en jours (0 = indéfiniment)
KAJI_AUDIT_RETENTION_DAYS=365

# --- Docker Compose ---
# Interface sur laquelle écouter. 127.0.0.1 = cette machine seulement (valeur sûre). 0.0.0.0 = tout le réseau.
KAJI_BIND=127.0.0.1
KAJI_PORT=8080

# --- HTTPS (option : docker-compose.tls.yml, voir docs/deploiement.md) ---
# Adresse par laquelle tu ouvres Kaji, SANS port : sert de nom au certificat interne de Caddy. HTTPS sur 443, et le port 80 renvoie vers HTTPS.
# KAJI_TLS_SITE=192.168.1.10
# Un NOM par lequel tu ouvres aussi Kaji (entrée DNS locale, ex. kaji.home) : le certificat couvre l'adresse ET ce nom. Doit différer de KAJI_TLS_SITE.
# KAJI_TLS_NAME=kaji.home
# KAJI_TLS_PORT=443
# KAJI_HTTP_PORT=80
# KAJI_TLS_BIND=0.0.0.0

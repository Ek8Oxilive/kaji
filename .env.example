# Clé secrète du dashboard (chiffrement des tokens Proxmox + sessions)
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
KAJI_SECRET_KEY=changeme

# Jeton de première configuration (facultatif mais recommandé) : tant qu'aucun compte n'existe, il est exigé pour créer le compte admin
# (sinon le premier qui atteint le port le crée). Générer : python3 -c "import secrets; print(secrets.token_urlsafe(24))"
KAJI_SETUP_TOKEN=

# Cookie de session en "Secure" (HTTPS ou localhost). Mettre false seulement en HTTP sur le réseau local.
KAJI_COOKIE_SECURE=true

# Machines que Kaji refuse de supprimer, quoi qu'il arrive (identifiants séparés par des virgules)
KAJI_PROTECTED_VMIDS=

# Session administrateur d'un clic avec le token permanent de Kaji (à n'activer que si ce token a reçu les droits d'administration dans Proxmox)
# KAJI_ADMIN_USE_KAJI_TOKEN=true

# Planificateur d'actions et alertes (une seule instance de Kaji doit tourner) : false les coupe
# KAJI_SCHEDULER=true

# Jetons Proxmox PERSONNELS (option A : chaque utilisateur de Kaji enregistre SON jeton, Proxmox applique ses droits et nomme la personne dans son journal ; docs/api/jetons-utilisateur.md).
# Clé qui les chiffre, SÉPARÉE de KAJI_SECRET_KEY (au moins 32 caractères aléatoires, différente de KAJI_SECRET_KEY). Sans elle, la fonction est désactivée.
# Mieux : un fichier hors de .env et hors de la sauvegarde (KAJI_TOKEN_KEY_FILE=/run/secrets/kaji_token_key, monté en lecture seule dans le conteneur).
# KAJI_TOKEN_KEY=
# KAJI_TOKEN_KEY_FILE=
# Pendant une rotation seulement : l'ancienne clé (puis `python -m app.admin_cli rotate-token-key --yes`, docs/deploiement.md).
# KAJI_TOKEN_KEY_PREVIOUS=
# true : un utilisateur sans jeton personnel n'a PAS accès à Proxmox (au lieu d'utiliser le jeton partagé de la connexion).
# KAJI_REQUIRE_USER_TOKEN=false
# Durée maximale (jours) acceptée pour un jeton personnel.
# KAJI_USER_TOKEN_MAX_DAYS=90
# Jetons Proxmox créés par l'administrateur depuis Kaji : l'expiration est OBLIGATOIRE et au plus ce nombre de jours (0 = facultative).
# KAJI_TOKEN_CREATE_MAX_DAYS=365

# JETON DE SERVICE (planificateur d'actions et alertes, quand personne n'est connecté ; docs/api/jeton-service.md) : un jeton LIMITÉ par connexion (jamais Administrator), enregistré par un
# administrateur (page « Connexions » → « Jeton de service… »). true : sans lui, ces fonctions ne font rien pour la connexion au lieu d'utiliser le jeton partagé.
# KAJI_REQUIRE_SERVICE_TOKEN=false
# KAJI_SERVICE_TOKEN_MAX_DAYS=365

# Requêtes HTTP simultanées au plus (hors santé, flux temps réel et consoles) ; au-delà : 503 tout de suite au lieu de tout bloquer (docs/robustesse.md). 0 = pas de limite.
# KAJI_MAX_CONCURRENT_REQUESTS=100

# Derrière un reverse proxy de confiance uniquement : utilise l'IP que le proxy ajoute dans X-Forwarded-For
# pour le limiteur de connexions (sinon l'en-tête est falsifiable et ignoré).
KAJI_TRUST_PROXY=false

# Seulement pendant une rotation de KAJI_SECRET_KEY : l'ANCIENNE clé (puis `python -m app.admin_cli rotate-secret-key --yes`, docs/runbook.md).
# KAJI_SECRET_KEY_PREVIOUS=

# Durée de conservation du journal d'audit, en jours (0 = indéfiniment)
KAJI_AUDIT_RETENTION_DAYS=365
# Export de l'audit (désactivé par défaut ; voir docs/api/audit-export.md). Fichier : chemin ABSOLU (dans Docker, mets-le dans le volume /data) ; syslog : udp://hôte:port ou tcp://hôte:port.
# KAJI_AUDIT_FILE=/data/audit.jsonl
# KAJI_AUDIT_FILE_MAX_MB=10
# KAJI_AUDIT_FILE_BACKUPS=10
# KAJI_AUDIT_SYSLOG=udp://syslog.example.com:514
# SSO par OpenID Connect (docs/api/sso.md) : désactivé tant que KAJI_OIDC_ISSUER est vide. Le mot de passe local reste le repli.
# KAJI_OIDC_ISSUER=https://idp.example.com/realms/entreprise
# KAJI_OIDC_CLIENT_ID=kaji
# KAJI_OIDC_CLIENT_SECRET=
# KAJI_OIDC_REDIRECT_URI=https://kaji.example.com/api/auth/oidc/callback
# KAJI_OIDC_SCOPES=openid profile
# KAJI_OIDC_USERNAME_CLAIM=preferred_username
# KAJI_OIDC_AUTO_CREATE=false
# KAJI_OIDC_DEFAULT_ROLE=viewer
# KAJI_OIDC_LABEL=SSO
# Groupes → rôle (vides par défaut : aucun rôle n'est modifié). Un membre du groupe administrateur est administrateur de Kaji, donc de Proxmox.
# KAJI_OIDC_ALLOW_ADMIN=true
# KAJI_OIDC_GROUPS_CLAIM=groups
# KAJI_OIDC_ADMIN_GROUP=
# KAJI_OIDC_OPERATOR_GROUP=
# Connexion par annuaire LDAP / Active Directory (docs/api/ldap.md) : désactivée tant que KAJI_LDAP_URL est vide. Chiffrement obligatoire (ldaps:// ou KAJI_LDAP_START_TLS=true).
# KAJI_LDAP_URL=ldaps://annuaire.example.com:636
# KAJI_LDAP_START_TLS=false
# KAJI_LDAP_CA_FILE=
# KAJI_LDAP_TLS_SERVER_NAME=
# KAJI_LDAP_BASE_DN=dc=example,dc=com
# KAJI_LDAP_BIND_DN=cn=kaji-lecture,dc=example,dc=com
# KAJI_LDAP_BIND_PASSWORD=
# KAJI_LDAP_USER_FILTER=(&(objectClass=person)(uid={username}))
# KAJI_LDAP_USERNAME_ATTR=uid
# KAJI_LDAP_AUTO_CREATE=false
# KAJI_LDAP_DEFAULT_ROLE=viewer
# KAJI_LDAP_LABEL=Annuaire
# KAJI_LDAP_ALLOW_ADMIN=true
# KAJI_LDAP_GROUPS_ATTR=memberOf
# KAJI_LDAP_ADMIN_GROUP=
# KAJI_LDAP_OPERATOR_GROUP=

# --- Docker Compose ---
# Interface sur laquelle écouter. 127.0.0.1 = cette machine seulement (valeur sûre). 0.0.0.0 = tout le réseau.
KAJI_BIND=127.0.0.1
KAJI_PORT=8080

# --- HTTPS (option : docker-compose.tls.yml, voir docs/deploiement.md) ---
# Adresse par laquelle tu ouvres Kaji, SANS port : sert de nom au certificat interne de Caddy. HTTPS sur 443, et le port 80 renvoie vers HTTPS.
# KAJI_TLS_SITE=192.168.1.10
# Un NOM par lequel tu ouvres aussi Kaji (entrée DNS locale, ex. kaji.home) : le certificat couvre l'adresse ET ce nom. Doit différer de KAJI_TLS_SITE.
# KAJI_TLS_NAME=kaji.home
# KAJI_TLS_PORT=443
# KAJI_HTTP_PORT=80
# KAJI_TLS_BIND=0.0.0.0
